{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "loopSub",
  "version": "0.1.0",
  "identifier": "dev.loopsub.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "loopSub",
        "width": 1280,
        "height": 764,
        "minWidth": 800,
        "minHeight": 500,
        "alwaysOnTop": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/*"
    ],
    "category": "Video",
    "shortDescription": "Subtitle-driven language learning for mpv",
    "longDescription": "loopSub turns subtitles into a playback controller for TV-show language learning: sentence navigation, A-B loops, shadowing pauses, subtitle search and LLM translation, all by remote-controlling mpv.",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
