{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "loopSub",
  "version": "0.1.0",
  "identifier": "dev.loopsub.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "loopSub",
        "width": 440,
        "height": 760,
        "minWidth": 300,
        "minHeight": 200,
        "alwaysOnTop": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
